# ==============================================================================
# TWITCH ENGINE — ENVIRONMENT VARIABLES CONFIGURATION
#
# Production (Vercel): Add these variables in Project Settings > Environment Variables.
# Local Development: Rename/copy this file as '.env.local' and provide the credentials.
# ==============================================================================

# Twitch Helix API (https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=your_channel_name_here

# Valve Web API (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=
STEAM_USER_ID=

# RetroAchievements Web API (https://retroachievements.org/controlpanel.php)
RA_USER=
RA_API_KEY=

# RAWG Database API (https://rawg.io/apidocs)
RAWG_API_KEY=